-- Función para escanear armas dinámicamente
local function escanearArmas()
    local armas = {}
    local fuentes = {
        game.ReplicatedStorage:FindFirstChild("Weapons"),
        game.ReplicatedStorage:FindFirstChild("Guns"),
        game.ReplicatedStorage:FindFirstChild("Tools"),
        game.ReplicatedStorage:FindFirstChild("Items"),
        game.ServerStorage:FindFirstChild("Weapons"),
        game.ServerStorage:FindFirstChild("Guns")
    }
    
    for _, fuente in ipairs(fuentes) do
        if fuente then
            for _, item in ipairs(fuente:GetChildren()) do
                if item:IsA("Tool") or item:IsA("Model") then
                    table.insert(armas, item)
                end
            end
        end
    end
    
    -- Agregar armas comunes que no se encontraron
    for _, arma in ipairs(armasComunes) do
        if not table.find(armas, arma) then
            table.insert(armas, arma)
        end
    end
    
    return armas
end

-- Función para escanear warps dinámicamente
local function escanearWarps()
    local warps = {}
    
    -- Buscar en workspace
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name:lower():find("warp") or obj.Name:lower():find("teleport") or obj.Name:lower():find("spawn") then
            table.insert(warps, obj)
        end
    end
    
    -- Buscar en ReplicatedStorage
    local warpFolder = game.ReplicatedStorage:FindFirstChild("Warps") or game.ReplicatedStorage:FindFirstChild("Teleports")
    if warpFolder then
        for _, warp in ipairs(warpFolder:GetChildren()) do
            table.insert(warps, warp)
        end
    end
    
    -- Agregar warps comunes
    for _, warp in ipairs(warpsComunes) do
        if not table.find(warps, warp) then
            table.insert(warps, warp)
        end
    end
    
    return warps
end

-- Función para desbloquear armas
local function desbloquearArma(arma)
    pcall(function()
        local tool = nil
        
        -- Intentar obtener el tool
        if typeof(arma) == "string" then
            -- Buscar por nombre
            for _, folder in ipairs({"Weapons", "Guns", "Tools", "Items"}) do
                local fuente = game.ReplicatedStorage:FindFirstChild(folder)
                if fuente then
                    tool = fuente:FindFirstChild(arma)
                    if tool then break end
                end
            end
        elseif typeof(arma) == "Instance" then
            tool = arma
        end
        
        if tool and tool:IsA("Tool") then
            -- Clonar el tool al backpack
            local clone = tool:Clone()
            clone.Parent = player.Backpack
            
            -- Intentar equipar si es necesario
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid:EquipTool(clone)
            end
        else
            -- Intentar desbloquear via remotes
            local remotes = {
                game.ReplicatedStorage:FindFirstChild("UnlockWeapon"),
                game.ReplicatedStorage:FindFirstChild("GiveTool"),
                game.ReplicatedStorage:FindFirstChild("EquipItem")
            }
            
            for _, remote in ipairs(remotes) do
                if remote then
                    remote:FireServer(arma)
                end
            end
        end
    end)
end

-- Función para desbloquear warp
local function desbloquearWarp(warp)
    pcall(function()
        local pos = nil
        
        if typeof(warp) == "string" then
            -- Buscar por nombre
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj.Name:lower():find(warp:lower()) then
                    if obj:IsA("BasePart") then
                        pos = obj.Position
                        break
                    elseif obj:FindFirstChild("Position") then
                        pos = obj.Position.Position
                        break
                    end
                end
            end
        elseif typeof(warp) == "Instance" then
            if warp:IsA("BasePart") then
                pos = warp.Position
            elseif warp:FindFirstChild("Position") then
                pos = warp.Position.Position
            end
        end
        
        -- Teleportar al warp
        if pos and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
            local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = CFrame.new(pos)})
            tween:Play()
        end
    end)
end

-- Función principal UNLOCK ALL
local function unlockAll()
    local armas = escanearArmas()
    local warps = escanearWarps()
    
    -- Desbloquear todas las armas
    for _, arma in ipairs(armas) do
        desbloquearArma(arma)
        task.wait(0.05)
    end
    
    -- Desbloquear todos los warps
    for _, warp in ipairs(warps) do
        desbloquearWarp(warp)
        task.wait(0.05)
    end
    
    print("✅ TODAS las armas y warps desbloqueados")
end

