local isOpen, busy = false, false
local function fitScale()
	local vp = camNow().ViewportSize
	return math.clamp(math.min(vp.X / 600, vp.Y / 450), 0.45, 1)
end
local function setOpen(v)
	if busy or v == isOpen then return end
	isOpen, busy = v, true
	local base = fitScale()
	if v then
		main.Visible = true
		if State.Anim then
			scale.Scale = 0
			tw(scale, .35, { Scale = base }, Enum.EasingStyle.Back):Play()
			task.wait(.35)
		else scale.Scale = base end
	else
		if State.Anim then
			local t = tw(scale, .2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			t:Play() t.Completed:Wait()
		end
		main.Visible = false
	end
	busy = false
end

