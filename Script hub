local function refreshCircle()
	circ.Visible = aimOn and aimCircle
	circStroke.Color = State.Accent
end

local cAim = card(pAim, "🎯 AimAssets")
toggle(cAim, "Activar ayuda de apuntado", false, function(v) aimOn = v refreshCircle() end)
slider(cAim, "Fuerza (1-100)", 1, 100, 30, function(v) aimStrength = v end)
slider(cAim, "FOV (tamaño del círculo)", 20, 400, 120, function(v)
	aimFov = v
	circ.Size = UDim2.new(0, v * 2, 0, v * 2)
end)

local cAim2 = card(pAim, "⚙ Opciones")
toggle(cAim2, "Mostrar círculo FOV", true, function(v) aimCircle = v refreshCircle() end)
toggle(cAim2, "Apuntar a la cabeza", true, function(v) aimHead = v end)
toggle(cAim2, "Solo si lo veo (sin paredes)", true, function(v) aimWalls = v end)
toggle(cAim2, "Solo al mantener clic derecho", false, function(v) aimHold = v end)
label(cAim2, "Mueve la cámara suavemente hacia el jugador más cercano al centro de la pantalla, dentro del círculo.", 11, 44, true)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function pickTarget(cam)
	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestD = nil, aimFov
	for _, p in ipairs(Players:GetPlayers()) do
		local ch = p ~= lp and p.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local part = ch and ((aimHead and ch:FindFirstChild("Head")) or ch:FindFirstChild("HumanoidRootPart"))
		if part and hum and hum.Health > 0 then
			local v, on = cam:WorldToViewportPoint(part.Position)
			if on then
				local d = (Vector2.new(v.X, v.Y) - center).Magnitude
				if d < bestD then
					local visible = true
					if aimWalls then
						rayParams.FilterDescendantsInstances = { lp.Character, ch }
						local origin = cam.CFrame.Position
						visible = workspace:Raycast(origin, part.Position - origin, rayParams) == nil
					end
					if visible then best, bestD = part, d end
				end
			end
		end
	end
	return best
end

RunService:BindToRenderStep("AimAssets", Enum.RenderPriority.Camera.Value + 1, function()
	if not aimOn then return end
	if aimHold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
	local cam = camNow()
	local target = pickTarget(cam)
	if target then
		local goal = CFrame.lookAt(cam.CFrame.Position, target.Position)
		cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(aimStrength / 100 * 0.5, 0, 1))
	end
end)
end

