local InsertService = game:GetService("InsertService")

-- carga un asset (intenta varios métodos, todo protegido con pcall)
local function loadAsset(id)
	if not id or id == 0 then return nil end
	local ok, res = pcall(function() return InsertService:LoadAsset(id) end)
	if ok and res then return res end
	local ok2, res2 = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
	if ok2 and res2 and res2[1] then
		local m = Instance.new("Model")
		for _, o in ipairs(res2) do o.Parent = m end
		return m
	end
	return nil
end

local function findAtt(char, name)
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") then
			local a = part:FindFirstChild(name)
			if a and a:IsA("Attachment") then return a end
		end
	end
end

local function accKey(acc)
	local h = acc:FindFirstChild("Handle")
	local m = ""
	if h then
		if h:IsA("MeshPart") then m = h.MeshId
		else
			local sm = h:FindFirstChildWhichIsA("SpecialMesh")
			if sm then m = sm.MeshId end
		end
	end
	return acc.Name .. "|" .. m
end

-- pega un accesorio a mano (funciona en el cliente)
local function attachAccessory(char, acc)
	local handle = acc:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then acc:Destroy() return false end
	handle.Anchored = false
	handle.CanCollide = false
	handle.Massless = true
	local att = handle:FindFirstChildOfClass("Attachment")
	local weld = Instance.new("Weld")
	weld.Name = "AccessoryWeld"
	if att then
		local target = findAtt(char, att.Name)
		if not target then acc:Destroy() return false end
		weld.Part0 = handle
		weld.C0 = att.CFrame
		weld.Part1 = target.Parent
		weld.C1 = target.CFrame
		handle.CFrame = target.Parent.CFrame * target.CFrame * att.CFrame:Inverse()
	else
		local head = char:FindFirstChild("Head")
		if not head then acc:Destroy() return false end
		weld.Part0 = head
		weld.C0 = CFrame.new(0, 0.5, 0)
		weld.Part1 = handle
		weld.C1 = acc.AttachmentPoint
	end
	weld.Parent = handle
	acc.Parent = char
	return true
end

-- CARA ---------------------------------------------------------------------
local DEFAULT_FACE = "rbxasset://textures/face.png"
local function applyFace(char, faceId)
	local head = char:FindFirstChild("Head")
	if not head then return false end
	local decal
	for _, d in ipairs(head:GetChildren()) do
		if d:IsA("Decal") then decal = decal or d end
	end
	if not decal then
		decal = Instance.new("Decal")
		decal.Name = "face"
		decal.Face = Enum.NormalId.Front
		decal.Parent = head
	end
	if not faceId or faceId == 0 then
		decal.Texture = DEFAULT_FACE
		return true
	end
	local tex
	local fm = loadAsset(faceId)
	if fm then
		local d = fm:FindFirstChildWhichIsA("Decal", true)
		if d then tex = d.Texture end
		fm:Destroy()
	end
	decal.Texture = tex or ("rbxassetid://" .. faceId)
	return true
end

-- ANIMACIONES ------------------------------------------------------------------
local animFields = { "IdleAnimation", "WalkAnimation", "RunAnimation", "JumpAnimation", "FallAnimation", "ClimbAnimation", "SwimAnimation" }
local animSnap = setmetatable({}, { __mode = "k" })

local function snapAnimate(animate)
	if animSnap[animate] then return end
	local s = {}
	for _, a in ipairs(animate:GetDescendants()) do
		if a:IsA("Animation") then s[a] = a.AnimationId end
	end
	animSnap[animate] = s
end
local function restoreAnimate(animate)
	local s = animSnap[animate]
	if not s then return end
	for a, id in pairs(s) do if a.Parent then a.AnimationId = id end end
end
local function restartAnimate(animate, hum)
	animate.Disabled = true
	local src = hum:FindFirstChildOfClass("Animator") or hum
	pcall(function()
		for _, tr in ipairs(src:GetPlayingAnimationTracks()) do tr:Stop() end
	end)
	task.wait()
	animate.Disabled = false
end
local function applyPack(animate, pack)
	local n = 0
	for _, anim in ipairs(pack:GetDescendants()) do
		if anim:IsA("Animation") and anim.Parent then
			local set = animate:FindFirstChild(anim.Parent.Name)
			local t = set and set:FindFirstChild(anim.Name)
			if t and t:IsA("Animation") then
				t.AnimationId = anim.AnimationId
				n += 1
			end
		end
	end
	return n
end

-- COPIAR AVATAR COMPLETO ---------------------------------------------------------
-- devuelve (éxito, {acc=, face=, anim=})
local function copyAvatar(userId)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local rep = { acc = 0, face = false, anim = 0 }
	if not hum then return false, rep end
	local animate = char:FindFirstChild("Animate")
	if animate then snapAnimate(animate) end
	local mine = (userId == lp.UserId)
	local base = false
	local worn = {}

	-- 1) apariencia: ropa, colores, accesorios, cabeza
	local ok, model = pcall(function() return Players:GetCharacterAppearanceAsync(userId) end)
	if ok and model then
		for _, v in ipairs(char:GetChildren()) do
			if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then
				v:Destroy()
			end
		end
		local head = char:FindFirstChild("Head")
		for _, v in ipairs(model:GetChildren()) do
			if v:IsA("Accessory") then
				local key = accKey(v)
				if attachAccessory(char, v) then rep.acc += 1 worn[key] = true end
			elseif v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then
				v.Parent = char
			elseif v.Name == "Head" and head then
				local mesh = v:FindFirstChildWhichIsA("SpecialMesh")
				if mesh then
					local old = head:FindFirstChildWhichIsA("SpecialMesh")
					if old then old:Destroy() end
					mesh.Parent = head
				end
			end
		end
		model:Destroy()
		base = true
	end

	-- 2) descripción: cara, accesorios que faltan, cabeza y animaciones
	local ok2, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
	if ok2 and desc then
		if not base then
			base = (pcall(function() hum:ApplyDescription(desc) end))
		end

		-- cara
		rep.face = applyFace(char, desc.Face)

		-- accesorios que faltaron (todos los tipos)
		local okL, list = pcall(function() return desc:GetAccessories(true) end)
		if okL and list then
			for _, a in ipairs(list) do
				local asset = loadAsset(a.AssetId)
				if asset then
					local acc = asset:FindFirstChildWhichIsA("Accessory", true)
					if acc then
						local key = accKey(acc)
						if worn[key] then
							acc:Destroy()
						elseif attachAccessory(char, acc) then
							rep.acc += 1 worn[key] = true
						end
					end
					asset:Destroy()
				end
			end
		end

		-- forma de cabeza (cabezas clásicas)
		if desc.Head and desc.Head ~= 0 then
			local hm = loadAsset(desc.Head)
			local headPart = char:FindFirstChild("Head")
			if hm and headPart then
				local mesh = hm:FindFirstChildWhichIsA("SpecialMesh", true)
				if mesh then
					local old = headPart:FindFirstChildWhichIsA("SpecialMesh")
					if old then old:Destroy() end
					mesh:Clone().Parent = headPart
				end
			end
			if hm then hm:Destroy() end
		end

		-- animaciones
		if animate then
			if mine then
				restoreAnimate(animate)
				restartAnimate(animate, hum)
			else
				for _, field in ipairs(animFields) do
					local id = desc[field]
					if id and id ~= 0 then
						local pack = loadAsset(id)
						if pack then
							rep.anim += applyPack(animate, pack)
							pack:Destroy()
						end
					end
				end
				if rep.anim > 0 then restartAnimate(animate, hum) end
			end
		end
	end

	return base, rep
end

