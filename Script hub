local pages, tabs = {}, {}
local function selectTab(name)
	for n, p in pairs(pages) do
		local vis = (n == name)
		if vis and not p.Visible and State.Anim then
			p.Position = UDim2.new(0, 20, 0, 0)
			p.Visible = true
			tw(p, .28, { Position = UDim2.new() }, Enum.EasingStyle.Quint):Play()
		else
			if vis then p.Position = UDim2.new() end
			p.Visible = vis
		end
	end
	for n, b in pairs(tabs) do
		themed[b] = (n == name) and "accent" or "panel"
		b.BackgroundTransparency = (n == name) and 0 or 0.4
		local ind = b:FindFirstChild("Ind")
		if ind then ind.Visible = (n == name) end
	end
	applyAll()
end
