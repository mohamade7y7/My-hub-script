local function callSearch(params)
	local ok, res = pcall(function() return AES:SearchCatalogAsync(params) end)
	if ok and res then return res end
	local ok2, res2 = pcall(function() return AES:SearchCatalog(params) end)
	if ok2 and res2 then return res2 end
	error(tostring(res2 or res))
end

local function buildParams()
	local params = CatalogSearchParams.new()
	params.SearchKeyword = keyword
	local cat = CATS[catIndex][2]
	if cat.assets then
		local l = enumList("AvatarAssetType", cat.assets)
		if #l > 0 then params.AssetTypes = l end
	end
	if cat.bundles then
		local l = enumList("BundleType", cat.bundles)
		if #l > 0 then params.BundleTypes = l end
	end
	if cat.filter then pcall(function() params.CategoryFilter = Enum.CatalogCategoryFilter[cat.filter] end) end
	pcall(function() params.SortType = Enum.CatalogSortType[SORTS[sortIndex][2]] end)
	pcall(function() params.IncludeOffSale = true end)
	pcall(function() params.Limit = 120 end)
	return params
end

local function search(reset)
	if shopLoading then return end
	if viewWorn then
		viewWorn = false
		if wornChipRef then themed[wornChipRef] = "panel" applyAll() end
	end
	shopLoading = true
	loadedOnce = true
	if reset then
		for _, c in ipairs(grid:GetChildren()) do
			if c:IsA("GuiObject") and c ~= moreBtn then c:Destroy() end
		end
		shopPages, shopCount, cardStrokes = nil, 0, {}
	end
	moreBtn.Visible = false
	statusLbl.Text = "Cargando catálogo..."
	task.spawn(function()
		local ok, err = pcall(function()
			if not shopPages then
				shopPages = callSearch(buildParams())
			else
				shopPages:AdvanceToNextPageAsync()
			end
			for _, it in ipairs(shopPages:GetCurrentPage()) do addCard(it) end
		end)
		shopLoading = false
		if ok then
			moreBtn.Visible = not shopPages.IsFinished
			refreshStatus()
		else
			statusLbl.Text = "No se pudo cargar el catálogo (el juego puede bloquearlo)"
			warn("[Shop] " .. tostring(err))
		end
	end)
end

