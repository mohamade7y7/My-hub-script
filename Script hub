-- ===== motor de "probar" =====
local function newRec() return { objs = {}, cloth = {}, anim = {}, face = nil, parts = 0 } end

local function wearCloth(char, o, rec)
	local cls = o.ClassName
	local slot = slots[cls]
	if slot then
		if slot.cur and slot.cur.Parent then slot.cur:Destroy() end
	else
		local old = char:FindFirstChildOfClass(cls)
		if old then old.Parent = nil end
		slot = { orig = old }
		slots[cls] = slot
	end
	slot.cur = o
	o.Parent = char
	table.insert(rec.cloth, o)
end

local function setAnim(rec, target, id)
	if rec.anim[target] == nil then rec.anim[target] = target.AnimationId end
	target.AnimationId = id
end

local function applyPackRec(animate, pack, rec)
	local n = 0
	for _, anim in ipairs(pack:GetDescendants()) do
		if anim:IsA("Animation") and anim.Parent then
			local set = animate:FindFirstChild(anim.Parent.Name)
			local t = set and set:FindFirstChild(anim.Name)
			if t and t:IsA("Animation") then setAnim(rec, t, anim.AnimationId) n += 1 end
		end
	end
	return n
end

local function harvest(char, container, rec, tid)
	local got = false
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animate = char:FindFirstChild("Animate")
	local hasAnim = false
	local descs = container:GetDescendants()
	for _, o in ipairs(descs) do
		if o:IsA("Accessory") then
			if attachAccessory(char, o) then table.insert(rec.objs, o) got = true end
		elseif o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic") then
			wearCloth(char, o, rec) got = true
		elseif o:IsA("Animation") then
			hasAnim = true
		end
	end
	if not got and not hasAnim then
		local d = container:FindFirstChildWhichIsA("Decal", true)
		local head = char:FindFirstChild("Head")
		if d and head then
			local hd = head:FindFirstChildWhichIsA("Decal")
			if not hd then
				hd = Instance.new("Decal") hd.Name = "face" hd.Face = Enum.NormalId.Front hd.Parent = head
			end
			if not rec.face then rec.face = { decal = hd, old = hd.Texture } end
			hd.Texture = d.Texture
			got = true
		end
	end
	if hasAnim and animate and hum then
		snapAnimate(animate)
		local n = applyPackRec(animate, container, rec)
		local s = slotFor[tid]
		if n == 0 and s then
			local anims = {}
			for _, o in ipairs(descs) do if o:IsA("Animation") then table.insert(anims, o) end end
			local set = animate:FindFirstChild(s[1])
			local t = set and set:FindFirstChild(s[2])
			if t and anims[1] then
				setAnim(rec, t, anims[1].AnimationId) n = 1
				if s[1] == "idle" then
					local t2 = set:FindFirstChild("Animation2")
					if t2 then setAnim(rec, t2, (anims[2] or anims[1]).AnimationId) end
				end
			end
		end
		if n > 0 then restartAnimate(animate, hum) got = true end
	end
	return got
end

-- plan B: construir el item con una HumanoidDescription
local function viaDescription(char, aid, tid, rec)
	if not tid then return false end
	local desc = Instance.new("HumanoidDescription")
	local am = ACC_MAP[tid]
	local s = slotFor[tid]
	if am then
		local ok, et = pcall(function() return Enum.AccessoryType[am[1]] end)
		if not ok then return false end
		desc:SetAccessories({ { Order = 1, AssetId = aid, AccessoryType = et, IsLayered = am[2] or false } }, true)
	elseif tid == 11 then desc.Shirt = aid
	elseif tid == 12 then desc.Pants = aid
	elseif tid == 2 then desc.GraphicTShirt = aid
	elseif tid == 18 then desc.Face = aid
	elseif s then desc[s[3]] = aid
	else return false end
	local ok, model = pcall(function() return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15) end)
	if not (ok and model) then return false end
	local got = false
	if s then
		local animate = char:FindFirstChild("Animate")
		local hum = char:FindFirstChildOfClass("Humanoid")
		local mAnimate = model:FindFirstChild("Animate")
		if animate and hum and mAnimate then
			local src = mAnimate:FindFirstChild(s[1]) and mAnimate[s[1]]:FindFirstChild(s[2])
			local dst = animate:FindFirstChild(s[1]) and animate[s[1]]:FindFirstChild(s[2])
			if src and dst then
				snapAnimate(animate)
				setAnim(rec, dst, src.AnimationId)
				restartAnimate(animate, hum)
				got = true
			end
		end
	else
		got = harvest(char, model, rec, tid)
	end
	model:Destroy()
	return got
end

local function tryAsset(char, aid, rec)
	local info
	pcall(function() info = MarketplaceService:GetProductInfo(aid, Enum.InfoType.Asset) end)
	local tid = info and info.AssetTypeId
	local asset = loadAsset(aid)
	local got = false
	if asset then
		got = harvest(char, asset, rec, tid)
		asset:Destroy()
	end
	if not got then got = viaDescription(char, aid, tid, rec) end
	if got then rec.parts += 1 end
	return got
end

local function bundleAssets(id)
	local list, d = {}, nil
	pcall(function() d = AES:GetItemDetails(id, Enum.AvatarItemType.Bundle) end)
	if not d then pcall(function() d = AES:GetItemDetailsAsync(id, Enum.AvatarItemType.Bundle) end) end
	if d then
		local items = d.BundledItems or d.Items or d.bundledItems
		if items then
			for _, b in ipairs(items) do
				if tostring(b.Type) == "Asset" then table.insert(list, b.Id) end
			end
		end
	end
	return list
end

local function tryOn(it)
	local char = lp.Character
	if not char or not char:FindFirstChildOfClass("Humanoid") then return nil end
	local rec = newRec()
	if isBundleItem(it) then
		for _, aid in ipairs(bundleAssets(it.Id)) do tryAsset(char, aid, rec) end
	else
		tryAsset(char, it.Id, rec)
	end
	if rec.parts > 0 then return rec end
	return nil
end

local function removeRec(rec)
	for _, o in ipairs(rec.objs) do o:Destroy() end
	for _, o in ipairs(rec.cloth) do
		local slot = slots[o.ClassName]
		if slot and slot.cur == o then
			o:Destroy()
			if slot.orig then pcall(function() slot.orig.Parent = lp.Character end) end
			slots[o.ClassName] = nil
		else
			o:Destroy()
		end
	end
	if rec.face and rec.face.decal.Parent then rec.face.decal.Texture = rec.face.old end
	local any = false
	for a, id in pairs(rec.anim) do
		if a.Parent then a.AnimationId = id any = true end
	end
	if any then
		local char = lp.Character
		local animate = char and char:FindFirstChild("Animate")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if animate and hum then restartAnimate(animate, hum) end
	end
end

