local State = {
	Menu = Color3.fromRGB(18, 20, 32),
	Accent = Color3.fromRGB(0, 140, 255),
	Text = WHITE,
	Anim = true,
	Rainbow = false,
}
local themed, texts = {}, {}
local stroke
local orderN = 0
local function nextOrder() orderN += 1 return orderN end

local function colorFor(kind)
	if kind == "bg" then return State.Menu
	elseif kind == "panel" then return State.Menu:Lerp(WHITE, 0.07)
	elseif kind == "card" then return State.Menu:Lerp(WHITE, 0.1)
	else return State.Accent end
end
local function theme(obj, kind) themed[obj] = kind obj.BackgroundColor3 = colorFor(kind) end
local function txt(obj) texts[obj] = true obj.TextColor3 = State.Text end
local function applyAll()
	for obj, kind in pairs(themed) do
		if obj.Parent then obj.BackgroundColor3 = colorFor(kind) else themed[obj] = nil end
	end
	for obj in pairs(texts) do
		if obj.Parent then obj.TextColor3 = State.Text else texts[obj] = nil end
	end
	if stroke and not State.Rainbow then stroke.Color = State.Accent end
end

-- HELPERS ----------------------------------------------------------------
local function tw(obj, t, props, style, dir)
	return TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
end
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function round(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end

local function button(parent, text, size, pos, kind)
	local b = new("TextButton", {
		Text = text, Size = size, Position = pos or UDim2.new(), AutoButtonColor = false,
		Font = Enum.Font.GothamBold, TextSize = 13, BorderSizePixel = 0,
	}, parent)
	round(b, 8) theme(b, kind or "accent") txt(b)
	new("UIGradient", { Color = ColorSequence.new(WHITE, Color3.fromRGB(205, 205, 220)), Rotation = 90 }, b)
	local sc = new("UIScale", {}, b)
	b.MouseEnter:Connect(function() if State.Anim then tw(sc, .12, { Scale = 1.04 }):Play() end end)
	b.MouseLeave:Connect(function() tw(sc, .12, { Scale = 1 }):Play() end)
	b.MouseButton1Down:Connect(function() if State.Anim then tw(sc, .08, { Scale = .94 }):Play() end end)
	b.MouseButton1Up:Connect(function() tw(sc, .08, { Scale = State.Anim and 1.04 or 1 }):Play() end)
	return b
end

