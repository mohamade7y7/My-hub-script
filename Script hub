local function parseImage(s)
	s = (s or ""):gsub("%s", "")
	if s == "" then return nil end
	local id = s:match("rbxassetid://(%d+)") or s:match("[?&]id=(%d+)") or s:match("/library/(%d+)")
		or s:match("/catalog/(%d+)") or s:match("/store/asset/(%d+)") or s:match("^(%d+)$")
	return id and ("rbxassetid://" .. id) or nil
end
local function setBackground(s)
	local img = parseImage(s)
	if img then bgImg.Image = img bgImg.Visible = true return true end
	bgImg.Visible = false
	return false
end

