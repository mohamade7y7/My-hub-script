do
local pAim = listPage("AimAssets")
local aimOn, aimStrength, aimFov = false, 30, 120
local aimHold, aimHead, aimWalls, aimCircle = false, true, true, true

local aimGui = new("ScreenGui", { Name = "AimFov", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 99 }, lp:WaitForChild("PlayerGui"))
local circ = new("Frame", {
